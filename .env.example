# Copiar a .env. Generar secretos propios antes de exponer el servicio.
DB_PASSWORD=replace-with-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
VISIT_SECRET=replace-with-a-different-random-secret
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-at-least-12-characters
# Subred Docker; cambiar si coincide con tu Wi-Fi, VPN u otra red local.
ALTURA_SUBNET=172.30.50.0/24
# Solo para despliegue opcional en Sepolia; nunca incluir claves en Git.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
