        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Palca · ejemplo sintético\",\n  \"description\": \"Solo demostración. No utilizar para navegar.\",\n  \"difficulty\": \"moderate\",\n  \"gpx_content\": \"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?>\\n<gpx version=\\\"1.1\\\" creator=\\\"Altura Paz - ejemplo sintético, no navegar\\\" xmlns=\\\"http://www.topografix.com/GPX/1/1\\\">\\n  <metadata><name>Palca - trazado ilustrativo</name><desc>Datos sintéticos para demostrar la importación. No es una ruta turística verificada.</desc></metadata>\\n  <trk><name>Recorrido ilustrativo</name><trkseg>\\n    <trkpt lat=\\\"-16.5570\\\" lon=\\\"-67.9560\\\"><ele>3400</ele></trkpt>\\n    <trkpt lat=\\\"-16.5550\\\" lon=\\\"-67.9535\\\"><ele>3430</ele></trkpt>\\n    <trkpt lat=\\\"-16.5518\\\" lon=\\\"-67.9520\\\"><ele>3470</ele></trkpt>\\n    <trkpt lat=\\\"-16.5490\\\" lon=\\\"-67.9490\\\"><ele>3510</ele></trkpt>\\n    <trkpt lat=\\\"-16.5457\\\" lon=\\\"-67.9470\\\"><ele>3550</ele></trkpt>\\n    <trkpt lat=\\\"-16.5420\\\" lon=\\\"-67.9450\\\"><ele>3590</ele></trkpt>\\n    <trkpt lat=\\\"-16.5390\\\" lon=\\\"-67.9420\\\"><ele>3580</ele></trkpt>\\n    <trkpt lat=\\\"-16.5350\\\" lon=\\\"-67.9400\\\"><ele>3630</ele></trkpt>\\n  </trkseg></trk>\\n</gpx>\\n\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
